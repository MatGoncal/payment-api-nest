{
  "moduleFileExtensions": ["js", "json", "ts"],
  "rootDir": "..",
  "testEnvironment": "node",
  "testRegex": "test/integration/.*\\.int-spec\\.ts$",
  "globalSetup": "<rootDir>/test/integration/helpers/global-setup.ts",
  "transform": {
    "^.+\\.(t|j)s$": "ts-jest"
  },
  "testTimeout": 60000,
  "maxWorkers": 1
}
