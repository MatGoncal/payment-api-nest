PORT=3001
NODE_ENV=development

DATABASE_URL=postgresql://acmepay:acmepay@localhost:5433/acmepay?schema=public

# Integration suite (npm run test:int) — truncates every table, so keep it
# separate from the dev database. Start it with:
#   docker compose --profile test up -d postgres-test
TEST_DATABASE_URL=postgresql://acmepay:acmepay@localhost:5434/acmepay_test?schema=public

REDIS_HOST=localhost
REDIS_PORT=6380

WEBHOOK_SECRET=dev-webhook-secret
WEBHOOK_TOLERANCE_SECONDS=300
DEMO_PARTNER_API_KEY=demo-partner-key
FX_RATE_LOCK_SECONDS=300

# fake-pix-provider in Docker (published :8080). Tests mock fetch.
FAKE_PIX_BASE_URL=http://127.0.0.1:8080
FAKE_PIX_API_KEY=fake-pix-demo
FAKE_PIX_CALLBACK_URL=http://host.docker.internal:3001/v1/webhooks/payment
